# --- Optional: Supabase (required for Vercel / multi-instance hosting) ---
# Project URL + anon key: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SECRET, server only - never prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
# Random string used to sign host tokens. Set this on Vercel (e.g. `openssl rand -hex 32`)
ROOM_SECRET=
